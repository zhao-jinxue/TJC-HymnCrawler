    {
      "id": 310,
      "no": "305",
      "name": "儆醒自責",
      "lyrics": [
        {
          "text": "惟真神是我父，不多敬愛；\r\n貪愛世界宴樂，難得神悅。"
        },
        {
          "text": "惟教會是我家，不多關心；\r\n醉心名利、虛華，難得神悅。"
        },
        {
          "text": "惟聖靈是我寶，不多禱告；\r\n未能多結善果，難得神悅。"
        },
        {
          "text": "惟傳道是我職，不多出力；\r\n信德有名無實，難得神悅。"
        }
      ],
      "lyrics_chorus": "求聖靈全更新，使我變為新人；\r\n效法主耶穌榜樣，榮耀真神。",
      "sheet_score_pdf": "uploads/hymn/score/sheet/305.pdf",
      "sheet_score_images": "[]",
      "num_score_pdf": "uploads/hymn/score/num/305.pdf",
      "num_score_xml": "",
      "category_id": 44,
      "created_at": "2022-07-09T16:00:00.000000Z",
