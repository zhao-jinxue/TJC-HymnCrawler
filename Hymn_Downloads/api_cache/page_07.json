  "data": [
    {
      "id": 61,
      "no": "60",
      "name": "行走天路",
      "lyrics": [
        {
          "text": "天國路要喜歡走，主引領，光而明即天國路；\r\n不論遇平坦、險阻，莫搶前，也莫落後，主引領。"
        },
        {
          "text": "天國路要努力走，主引領，窄而小即天國路；\r\n眾仇敵百般引誘，靠救主得勝有餘，主引領。"
        },
        {
          "text": "天國路要忍耐走，主引領，艱而難即天國路；\r\n將信心堅持到底，金在爐，大匠看守，主引領。"
        },
        {
          "text": "天國路要從容走，主引領，中而庸即天國路；\r\n祈禱靠聖靈幫助，莫偏左，也莫偏右，主引領。"
        }
      ],
      "lyrics_chorus": "",
      "sheet_score_pdf": "uploads/hymn/score/sheet/60.pdf",
      "sheet_score_images": "[]",
      "num_score_pdf": "uploads/hymn/score/num/60.pdf",
