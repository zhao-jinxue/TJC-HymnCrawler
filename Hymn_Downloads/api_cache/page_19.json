  "data": [
    {
      "id": 181,
      "no": "178",
      "name": "趁還有今天",
      "lyrics": [
        {
          "text": "趁還有今天，棄絕罪途；\r\n趁還有今天，相信耶穌。\r\n切莫自以為是，切莫輕忽主恩；\r\n趁著還有今天，求告救主。"
        },
        {
          "text": "趁還有今天，接受救主；\r\n趁還有今天，跟隨耶穌。\r\n耶穌願你回來，同靈為你代求；\r\n趁著還有今天，接受主愛。"
        },
        {
          "text": "切莫再耽延，喪失救贖；\r\n切莫再耽延，快信耶穌。\r\n主恩門將關閉，切莫錯失良機；\r\n趁著還有今天，歸向耶穌。"
        }
      ],
      "lyrics_chorus": "",
      "sheet_score_pdf": "uploads/hymn/score/sheet/178.pdf",
      "sheet_score_images": "[]",
      "num_score_pdf": "uploads/hymn/score/num/178.pdf",
      "num_score_xml": "",
      "category_id": 26,
