    {
      "id": 119,
      "no": "118",
      "name": "奉獻全生",
      "lyrics": [
        {
          "text": "虔誠奉獻我財物，願為聖工盡本分；\r\n虔誠奉獻我知識，任主使用盡所能。"
        },
        {
          "text": "虔誠奉獻我歌喉，只有歌詠君王恩；\r\n虔誠奉獻我舌頭，時時傳達主聲音。"
        },
        {
          "text": "虔誠奉獻我雙手，主愛激勵勤工作；\r\n虔誠奉獻我雙足，奉命奔跑美又速。"
        },
        {
          "text": "虔誠奉獻我光陰；讓主差遣傳福音；\r\n虔誠奉獻我全生，終身遵主旨意行。"
        }
      ],
      "lyrics_chorus": "全為主，勤為主，歡然、忠誠永為主。",
      "sheet_score_pdf": "uploads/hymn/score/sheet/118.pdf",
      "sheet_score_images": "[]",
      "num_score_pdf": "uploads/hymn/score/num/118.pdf",
