  "data": [
    {
      "id": 281,
      "no": "277",
      "name": "喜傳福音",
      "lyrics": [
        {
          "text": "我傳福音喜不勝，所講耶穌救人，\r\n如何自天而降臨？如何在地受刑？\r\n我要宣傳主福音，因為恩道是真，\r\n勝過世上多黃金，使我喜樂滿心。"
        },
        {
          "text": "我傳福音喜不勝，所講除罪更新，\r\n如何受洗做新人？如何懇求聖靈？\r\n我要宣傳主福音，因為應許是真，\r\n奉命見證對萬民，不怕許多艱辛。"
        },
        {
          "text": "我傳福音喜不勝，所講耶穌再臨，\r\n如何預備迎主心？如何進入天城？\r\n我要宣傳主福音，因為賞賜是真，\r\n竭力跑盡我路程，見主大顯光榮。"
        }
      ],
      "lyrics_chorus": "我傳福音喜不勝，得與救主日相親；\r\n宣揚得救之福音，頌讚耶穌慈仁。",
      "sheet_score_pdf": "uploads/hymn/score/sheet/277.pdf",
      "sheet_score_images": "[]",
      "num_score_pdf": "uploads/hymn/score/num/277.pdf",
      "num_score_xml": "",
      "category_id": 37,
      "created_at": "2022-07-09T16:00:00.000000Z",
