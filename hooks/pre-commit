#!/bin/bash
# pre-commit 钩子：提交前快速提醒并发 git 操作（不执行长耗时任务）。
#
# 背景：早期版本在提交时全量重建 checksums.json（计算 3017 个文件 SHA-256，
# 耗时数十秒），导致提交命令在自动化工具中触发超时中断。
# 现改为轻量模式：仅检测是否有未暂存的 checksums.json 改动并提示手动更新。
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# 若 Hymn_Downloads 下有未暂存的 checksums.json 改动，给出提示（不自动更新）
if ! git diff --quiet -- Hymn_Downloads 2>/dev/null; then
    echo "[pre-commit] 提示: Hymn_Downloads 中的大文件哈希未同步到 checksums.json"
    echo "[pre-commit] 如需更新，请手动执行: python3 -m crawler_core.checksums && git add Hymn_Downloads"
fi

exit 0
