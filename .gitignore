# 忽略 Python 缓存
__pycache__/
*.py[cod]
*$py.class

# 忽略 Hymn_Downloads 下的大文件（音频/PDF/视频/文本），但保留哈希清单
/Hymn_Downloads/**
!/Hymn_Downloads/**/
!/Hymn_Downloads/**/*.json

# url_map.txt（编号->目录名映射）加入跟踪，防止丢失（可用 step4 --rebuild-map 重建）
!/Hymn_Downloads/url_map.txt

# step2/5/7 的 *_progress.json 为断点续跑临时状态，不跟踪（需置于上面的 !json 白名单之后）
/Hymn_Downloads/step2_progress.json
/Hymn_Downloads/step5_progress.json
/Hymn_Downloads/step7_progress.json
/Hymn_Downloads/lyrics_progress.json

# 数据库文件（probe_report.json 保留跟踪，作为 db 重建的保险）
*.db-journal

# 大型二进制安装包（禁止提交，避免 git 仓库膨胀与提交卡顿）
*.exe
*.msi
*.dmg
*.zip
*.tar.gz
*.7z

